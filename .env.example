# Required Telegram secret.
TELEGRAM_BOT_TOKEN=replace-me

# Telegram usernames allowed to use the bot (comma-separated, @ is optional).
# Each username is bound to its numeric Telegram ID on the first message.
ALLOWED_USERNAMES=some_username,another_username

# Persistence. SQLite is the default and is suitable for one RPI5 bot.
DATABASE_URL=sqlite+aiosqlite:///./data/ozon_tracker.db

# Optional runtime tuning.
POLL_INTERVAL_SECONDS=900
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
